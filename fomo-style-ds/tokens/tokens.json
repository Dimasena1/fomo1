{
  "$description": "Design tokens for the FOMO-style design system. Source of truth: edit here, then mirror into app/globals.css (or build with Style Dictionary).",
  "color": {
    "bg": { "$type": "color", "$value": "#060510", "$description": "Page background on every screen" },
    "surface": { "$type": "color", "$value": "#0F0D1F", "$description": "Cards, bet slip, sidebar" },
    "surface-2": { "$type": "color", "$value": "#1A1730", "$description": "Hover state, nested cards, inputs" },
    "border": { "$type": "color", "$value": "rgba(255, 255, 255, 0.08)", "$description": "Card and input borders" },
    "text": { "$type": "color", "$value": "#F4F2FF", "$description": "Primary text" },
    "text-muted": { "$type": "color", "$value": "#8E8AA8", "$description": "Captions, secondary text" },
    "accent": { "$type": "color", "$value": "#8B5CF6", "$description": "Primary buttons, active states, glows" },
    "accent-strong": { "$type": "color", "$value": "#7C4DEF", "$description": "Filled primary buttons; white text on it is 5:1" },
    "accent-soft": { "$type": "color", "$value": "rgba(139, 92, 246, 0.15)", "$description": "Tinted badge / selected preset background" },
    "win": { "$type": "color", "$value": "#22C55E", "$description": "Positive PnL, won bet" },
    "loss": { "$type": "color", "$value": "#EF4444", "$description": "Negative PnL, lost bet" }
  },
  "radius": {
    "sm": { "$type": "dimension", "$value": "8px" },
    "md": { "$type": "dimension", "$value": "12px", "$description": "Inputs, image frames" },
    "lg": { "$type": "dimension", "$value": "16px", "$description": "Cards" },
    "xl": { "$type": "dimension", "$value": "24px", "$description": "Large panels, device mockups" },
    "pill": { "$type": "dimension", "$value": "9999px", "$description": "Buttons, badges, presets" }
  },
  "shadow": {
    "glow": { "$type": "shadow", "$value": "0 0 48px rgba(139, 92, 246, 0.35)", "$description": "Behind hero and primary CTA" },
    "glow-sm": { "$type": "shadow", "$value": "0 0 24px rgba(139, 92, 246, 0.25)" }
  },
  "font": {
    "family": { "$type": "fontFamily", "$value": ["Geist", "Inter", "system-ui", "sans-serif"] },
    "display": { "$type": "typography", "$value": { "fontSize": "clamp(40px, 6vw, 72px)", "lineHeight": "1.02", "letterSpacing": "-0.03em", "fontWeight": 600, "textTransform": "lowercase" } },
    "heading": { "$type": "typography", "$value": { "fontSize": "32px", "lineHeight": "1.1", "letterSpacing": "-0.02em", "fontWeight": 600, "textTransform": "lowercase" } },
    "body": { "$type": "typography", "$value": { "fontSize": "16px", "lineHeight": "1.5", "fontWeight": 400 } },
    "label": { "$type": "typography", "$value": { "fontSize": "11px", "lineHeight": "1", "letterSpacing": "0.08em", "fontWeight": 600, "textTransform": "uppercase" } }
  },
  "space": {
    "1": { "$type": "dimension", "$value": "4px" },
    "2": { "$type": "dimension", "$value": "8px" },
    "3": { "$type": "dimension", "$value": "12px" },
    "4": { "$type": "dimension", "$value": "16px" },
    "6": { "$type": "dimension", "$value": "24px" },
    "8": { "$type": "dimension", "$value": "32px" },
    "12": { "$type": "dimension", "$value": "48px" },
    "16": { "$type": "dimension", "$value": "64px" }
  },
  "motion": {
    "fast": { "$type": "duration", "$value": "200ms" },
    "base": { "$type": "duration", "$value": "300ms" },
    "easing": { "$type": "cubicBezier", "$value": [0.16, 1, 0.3, 1] }
  }
}
